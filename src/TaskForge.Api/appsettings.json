{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ExecutionMode": "Embedded",
  "Server": {
    "Port": 5000,
    "AutoOpenBrowser": false
  },
  "Redis": {
    "ConnectionString": ""
  },
  "PostgreSql": {
    "ConnectionString": ""
  },
  "Embedded": {
    "DatabasePath": "taskforge.db",
    "EnableSwagger": false
  },
  "Auth": {
    "RequireAuthentication": false,
    "HeaderName": "X-TaskForge-Key",
    "ApiKeys": []
  },
  "RateLimiting": {
    "Enabled": true,
    "DefaultRequestsPerSecond": 100,
    "DefaultBurstSize": 200,
    "QueueConcurrency": [
      { "QueueName": "default", "Namespace": "default", "MaxConcurrency": 5 },
      { "QueueName": "emails", "Namespace": "default", "MaxConcurrency": 10 },
      { "QueueName": "webhooks", "Namespace": "default", "MaxConcurrency": 20 },
      { "QueueName": "reports", "Namespace": "default", "MaxConcurrency": 3 }
    ]
  }
}
